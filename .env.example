NODE_ENV=development
PORT=3001

SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_COMMITMENT=confirmed

# Jupiter Developer Platform key. Keyless (no key) works at 0.5 RPS for dev only.
JUPITER_API_KEY=
JUPITER_BASE_URL=https://api.jup.ag/swap/v2
JUPITER_PRICE_URL=https://api.jup.ag/price/v3

# 0x Swap API (Solana quoter #2, open beta). Free key via https://dashboard.0x.org.
# Empty = 0x leg disabled; Jupiter + last-good still serve prices.
ZEROEX_API_KEY=
ZEROEX_BASE_URL=https://api.0x.org

# Pyth Pro API key (demo keys cover a limited feed set). Free key via https://docs.pyth.network/price-feeds/pro
PYTH_API_KEY=
PYTH_PRO_URL=https://pyth-lazer.dourolabs.app
PYTH_SYMBOLOGY_URL=https://pyth.dourolabs.app

# Finnhub for xStocks marketCap (free 60/min via https://finnhub.io/register). Empty = mcap stays null.
FINNHUB_API_KEY=

XSTOCKS_API_BASE_URL=https://api.xstocks.fi/api/v2

# Render free Postgres connection string. When set, the transaction ledger
# persists in Postgres (schema auto-applied on boot); when unset, in-memory.
DATABASE_URL=

CORS_ORIGINS=http://localhost:3000
