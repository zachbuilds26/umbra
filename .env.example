NODE_ENV=development
PORT=3002

SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_COMMITMENT=confirmed

# Tokens Assets API key (stocks page market data). Key via https://app.tokens.xyz. Empty = Tokens leg disabled.
TOKENS_API_KEY=
TOKENS_BASE_URL=https://api.tokens.xyz/v1
# Jupiter Developer Platform key. Keyless (no key) works at 0.5 RPS for dev only.
JUPITER_API_KEY=
JUPITER_BASE_URL=https://api.jup.ag/swap/v2
JUPITER_PRICE_URL=https://api.jup.ag/price/v3

# 0x Swap API (Solana quoter #2, open beta). Free key via https://dashboard.0x.org.
# Empty = 0x leg disabled; Jupiter + last-good still serve prices.
ZEROEX_API_KEY=
ZEROEX_BASE_URL=https://api.0x.org

XSTOCKS_API_BASE_URL=https://api.xstocks.fi/api/v2

# Binance Web3 API (BSC tokenized-stocks leg). Key via https://web3.binance.com/en/dev-portal.
# Server-side only — NEVER commit real values, NEVER expose to the frontend.
# Empty = BSC leg disabled; Solana keeps working.
BINANCE_API_KEY=
BINANCE_API_SECRET=
# Local-dev only: your ISP may filter Binance domains at DNS level. When set,
# Node resolves via these public servers instead of system DNS. Do NOT deploy.
# BINANCE_DNS_SERVERS=1.1.1.1,8.8.8.8

# Render free Postgres connection string. When set, the transaction ledger
# persists in Postgres (schema auto-applied on boot); when unset, in-memory.
DATABASE_URL=

CORS_ORIGINS=http://localhost:3000
